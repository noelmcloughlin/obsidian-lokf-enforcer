{
  "name": "@noelmcloughlin/lokf-enforcer",
  "version": "0.2.0",
  "description": "Validate the LOKF (Linked Open Knowledge Format) semantic layer on top of OKF v0.2 in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "smoke-test": "tsx scripts/smoke-test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "lokf",
    "okf",
    "linked-open-knowledge-format",
    "open-knowledge-format",
    "frontmatter",
    "metadata",
    "linked-data"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.0",
    "obsidian": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
